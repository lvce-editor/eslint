{
  "name": "@lvce-editor/node-shims",
  "version": "0.0.0-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "src/NodeShims.ts",
  "scripts": {
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:coverage": "npm test -- --coverage --runInBand"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "injectGlobals": false,
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "exports": {
    ".": "./src/NodeShims.ts",
    "./banner": "./src/NodeShimsBanner.ts",
    "./require": "./src/RequireShim.ts"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12"
  }
}
