{
  "name": "builtin.eslint",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "main": "dist/eslintMain.js",
  "scripts": {
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch"
  },
  "jest": {
    "injectGlobals": false,
    "setupFiles": [
      "fake-indexeddb/auto"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "dependencies": {
    "@lvce-editor/node-shims": "*",
    "pretty-bytes": "^7.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@lvce-editor/api": "^9.27.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12"
  }
}
