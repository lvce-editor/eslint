{
  "id": "builtin.eslint",
  "name": "ESLint",
  "description": "ESLint extension",
  "repository": "https://github.com/lvce-editor/eslint",
  "icon": "./media/icon.png",
  "browser": "dist/eslintMain.js",
  "workerName": "ESLint Worker",
  "isolated": true,
  "contentSecurityPolicy": [
    "default-src 'none'",
    "script-src 'self' 'unsafe-eval'"
  ],
  "categories": [],
  "activation": [
    "onDiagnostic:javascript",
    "onDiagnostic:typescript",
    "onDiagnostic:yaml",
    "onCodeAction:javascript",
    "onCodeAction:typescript",
    "onCodeAction:yaml",
    "onCommand:eslint.lint",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:yaml"
  ],
  "commands": [
    {
      "id": "eslint.lint",
      "label": "ESLint: Lint Document"
    }
  ],
  "outputChannels": [
    {
      "id": "eslint",
      "label": "ESLint"
    }
  ],
  "diagnosticProviders": [
    {
      "id": "eslint.javascript",
      "languageId": "javascript"
    },
    {
      "id": "eslint.typescript",
      "languageId": "typescript"
    },
    {
      "id": "eslint.yaml",
      "languageId": "yaml"
    }
  ],
  "languages": [
    {
      "id": "json",
      "fileNames": [".eslintrc"]
    },
    {
      "id": "ignore",
      "fileNames": [".eslintignore"]
    }
  ],
  "jsonValidation": [
    {
      "fileMatch": ".eslintrc",
      "url": "https://json.schemastore.org/eslintrc"
    },
    {
      "fileMatch": ".eslintrc.json",
      "url": "https://json.schemastore.org/eslintrc"
    }
  ]
}
