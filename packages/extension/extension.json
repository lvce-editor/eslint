{
  "id": "builtin.eslint",
  "name": "ESLint",
  "description": "ESLint extension",
  "repository": "https://github.com/lvce-editor/eslint",
  "icon": "./media/icon.png",
  "browser": "dist/eslintMain.js",
  "workerName": "ESLint Worker",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "rpc": [
    {
      "id": "builtin.eslint.evaluation-worker",
      "type": "web-worker",
      "name": "ESLint Evaluation Worker",
      "url": "dist/eslintEvaluationWorkerMain.js",
      "contentSecurityPolicy": [
        "default-src 'none'",
        "script-src 'self' 'unsafe-eval'"
      ]
    },
    {
      "id": "builtin.eslint.module-resolution-worker",
      "type": "web-worker",
      "name": "ESLint Module Resolution Worker",
      "url": "dist/moduleResolutionWorkerMain.js",
      "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"]
    }
  ],
  "categories": [],
  "activation": [
    "onDiagnostic:javascript",
    "onDiagnostic:typescript",
    "onDiagnostic:yaml",
    "onDiagnostic:css",
    "onDiagnostic:json",
    "onCodeAction:javascript",
    "onCodeAction:javascriptreact",
    "onCodeAction:typescript",
    "onCodeAction:typescriptreact",
    "onCodeAction:yaml",
    "onCodeAction:css",
    "onCodeAction:json",
    "onCommand:eslint.lint",
    "onCommand:eslint.showPerformanceTrace",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:yaml",
    "onLanguage:css",
    "onLanguage:json"
  ],
  "commands": [
    {
      "id": "eslint.lint",
      "label": "ESLint: Lint Document"
    },
    {
      "id": "eslint.showPerformanceTrace",
      "label": "ESLint: Show Performance Trace"
    }
  ],
  "outputChannels": [
    {
      "id": "eslint",
      "label": "ESLint"
    }
  ],
  "diagnosticProviders": [
    {
      "id": "eslint.javascript",
      "languageId": "javascript"
    },
    {
      "id": "eslint.javascriptreact",
      "languageId": "javascriptreact"
    },
    {
      "id": "eslint.typescript",
      "languageId": "typescript"
    },
    {
      "id": "eslint.typescriptreact",
      "languageId": "typescriptreact"
    },
    {
      "id": "eslint.yaml",
      "languageId": "yaml"
    },
    {
      "id": "eslint.css",
      "languageId": "css"
    },
    {
      "id": "eslint.json",
      "languageId": "json"
    }
  ],
  "languages": [
    {
      "id": "json",
      "fileNames": [".eslintrc"]
    },
    {
      "id": "ignore",
      "fileNames": [".eslintignore"]
    }
  ],
  "jsonValidation": [
    {
      "fileMatch": ".eslintrc",
      "url": "https://json.schemastore.org/eslintrc"
    },
    {
      "fileMatch": ".eslintrc.json",
      "url": "https://json.schemastore.org/eslintrc"
    }
  ]
}
