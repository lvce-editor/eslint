{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js", "scripts/*.js"]
    },
    "packages/build": {
      "project": ["src/**/*.js", "src/**/*.ts"],
      "ignoreFiles": ["src/esbuild-node-shim-plugin.ts"]
    },
    "packages/benchmark": {
      "entry": ["src/main.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/e2e": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/e2e/fixtures/*": {
      "entry": ["eslint.config.js", "test.{js,ts}"],
      "project": ["**/*.{css,js,json,ts,yml}"],
      "ignoreDependencies": ["eslint"]
    },
    "packages/e2e/fixtures/large-typescript-workspace": {
      "entry": [".eslint-plugin-local/*.ts", "eslint.config.js", "src/test.ts"],
      "project": ["**/*.{js,json,ts}"],
      "ignoreDependencies": ["eslint"]
    },
    "packages/eslint-evaluation-worker": {
      "entry": ["src/eslintEvaluationWorkerMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/extension": {
      "entry": ["src/eslintMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreFiles": [
        "src/parts/Assert/Assert.ts",
        "src/parts/AssertionError/AssertionError.ts",
        "src/parts/Command/Command.ts",
        "src/parts/CommandMap/CommandMap.ts",
        "src/parts/CommandNotFoundError/CommandNotFoundError.ts",
        "src/parts/ErrorCodes/ErrorCodes.ts"
      ],
      "ignoreIssues": {
        "src/parts/ExtensionHost/ExtensionHostCodeActionsProviderEslint.ts": [
          "exports",
          "types"
        ],
        "src/parts/ExtensionHost/ExtensionHostDiagnosticProviderEslint.ts": [
          "exports"
        ],
        "src/parts/Main/Main.ts": ["exports"]
      }
    },
    "packages/module-resolution-worker": {
      "entry": ["src/moduleResolutionWorkerMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreIssues": {
        "src/parts/ModuleResolution/ModuleResolution.ts": ["duplicates"]
      }
    },
    "packages/node-shims": {
      "entry": ["src/NodeShims.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreFiles": ["src/NodeShimsBanner.ts", "src/RequireShim.ts"]
    },
    "packages/server": {
      "project": ["src/**/*.js"]
    }
  }
}
